API_BASE_URL=https://your-api-domain.example.com
API_PAGE_SIZE=1000
AWS_REGION=us-east-1
AWS_PROFILE=your-aws-profile
S3_BUCKET_NAME=your-account-regional-bucket-name
S3_HISTORICAL_EXTRACT_DATE=YYYY-MM-DD
S3_HISTORICAL_RUN_ID=YYYYMMDDTHHMMSSffffffZ
POSTGRES_HOST=your-rds-endpoint.example.com
POSTGRES_PORT=5432
POSTGRES_DB=marketing_analytics
POSTGRES_USER=your-loader-user
POSTGRES_PASSWORD=replace-with-a-local-secret
POSTGRES_SSLMODE=verify-full
POSTGRES_SSLROOTCERT=/absolute/path/to/aws-rds-global-bundle.pem
POSTGRES_CONNECT_TIMEOUT_SECONDS=10
